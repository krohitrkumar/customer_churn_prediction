# ╔══════════════════════════════════════════════════════════════════╗
# ║                 SECRETS & ENVIRONMENT                           ║
# ╚══════════════════════════════════════════════════════════════════╝
.env
.env.*
!.env.example
*.env

# ╔══════════════════════════════════════════════════════════════════╗
# ║              PYTHON VIRTUAL ENVIRONMENT                         ║
# ╚══════════════════════════════════════════════════════════════════╝
venv/
.venv/
env/
ENV/

# ╔══════════════════════════════════════════════════════════════════╗
# ║               PYTHON CACHE & BYTECODE                           ║
# ╚══════════════════════════════════════════════════════════════════╝
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ╔══════════════════════════════════════════════════════════════════╗
# ║               LOCAL DATABASES (DEV ONLY)                        ║
# ╚══════════════════════════════════════════════════════════════════╝
*.db
*.sqlite3
*.sqlite

# ╔══════════════════════════════════════════════════════════════════╗
# ║              ML ARTIFACTS (LARGE BINARY FILES)                  ║
# ╚══════════════════════════════════════════════════════════════════╝
# The trained model is regenerated by: python ml_pipeline/train.py
ml_pipeline/artifacts/*.pkl
ml_pipeline/artifacts/*.joblib
ml_pipeline/artifacts/*.h5
ml_pipeline/artifacts/*.pt
ml_pipeline/artifacts/*.bin

# ╔══════════════════════════════════════════════════════════════════╗
# ║              NODE / FRONTEND                                    ║
# ╚══════════════════════════════════════════════════════════════════╝
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
.npm
.pnp.*

# ╔══════════════════════════════════════════════════════════════════╗
# ║                 BUILD OUTPUT                                    ║
# ╚══════════════════════════════════════════════════════════════════╝
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ╔══════════════════════════════════════════════════════════════════╗
# ║              LOGS & TEMP FILES                                  ║
# ╚══════════════════════════════════════════════════════════════════╝
*.log
logs/
*.tmp
*.temp
*.swp
*.swo

# ╔══════════════════════════════════════════════════════════════════╗
# ║              JUPYTER NOTEBOOK CHECKPOINTS                       ║
# ╚══════════════════════════════════════════════════════════════════╝
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ╔══════════════════════════════════════════════════════════════════╗
# ║              OPERATING SYSTEM FILES                             ║
# ╚══════════════════════════════════════════════════════════════════╝
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~

# ╔══════════════════════════════════════════════════════════════════╗
# ║              IDE & EDITOR FILES                                 ║
# ╚══════════════════════════════════════════════════════════════════╝
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ╔══════════════════════════════════════════════════════════════════╗
# ║              SECURITY — NEVER COMMIT THESE                      ║
# ╚══════════════════════════════════════════════════════════════════╝
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
