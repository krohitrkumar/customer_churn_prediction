# ─────────────────────────────────────────────────────────────
#  Customer Churn Intelligence Platform — Environment Template
#  Copy this file to backend/.env and fill in your values.
#  NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/churn_db

# SQLite (quick local dev, no setup needed):
# DATABASE_URL=sqlite:///./churn_database.db

# ── JWT Authentication ────────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_256_BIT_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Gmail SMTP (for OTP email delivery) ──────────────────────
# Leave SMTP_USER blank to use dev-mode (OTP prints to terminal instead)
# Gmail App Password: Google Account → Security → 2-Step → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_NAME=Customer Churn Intelligence

# ── ML Model Path (optional override) ────────────────────────
# Defaults to: ml_pipeline/artifacts/churn_model.pkl (auto-resolved)
# MODEL_PATH=/absolute/path/to/churn_model.pkl
